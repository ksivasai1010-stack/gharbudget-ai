# ─────────────────────────────────────────────
# GharBudget AI — .gitignore
# ─────────────────────────────────────────────

# ── Dependencies ─────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── Build Output ─────────────────────────────
dist/
client/dist/
server/dist/
build/
client/build/
server/build/

# ── Test Coverage ────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Environment Variables & Secrets ──────────
# Real .env files with API keys, JWT secrets,
# DB credentials — NEVER commit these.
.env
.env.*
server/.env
client/.env
!.env.example
!.env.*.example
!server/.env.example
!client/.env.example

# ── Logs ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ── Editor & IDE ─────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Operating System ─────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Temporary & Cache ────────────────────────
tmp/
temp/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ── Vite ─────────────────────────────────────
.vite/

# ── MongoDB ──────────────────────────────────
data/db/
*.mongodb

# ── Misc ─────────────────────────────────────
.env.example.copy
